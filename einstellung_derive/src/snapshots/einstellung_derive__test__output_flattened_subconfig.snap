                    ),
                )?,
            credentials: ::core::option::Option::Some(
                    self.credentials.unwrap_or_default(),
                )
                .map(|x| ::einstellung::PartialConfig::build(x))
                .transpose()?
                .ok_or(
                    ::einstellung::ConfigError::MissingField(
                        ::einstellung::FieldPath::new("AppConfig", "credentials"),
                    ),
                )?,
        })
    }
